#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
CANDIDATES=(
  "$SCRIPT_DIR/.."
  "$SCRIPT_DIR/repo"
  "$SCRIPT_DIR/../libexec/repo"
  "$SCRIPT_DIR/../share/altfins-skills/repo"
)

for candidate in "${CANDIDATES[@]}"; do
  if [ -f "$candidate/scripts/skills.py" ]; then
    export ALTFINS_SKILLS_ROOT="$(cd "$candidate" && pwd)"
    exec "${ALTFINS_SKILLS_PYTHON:-python3}" "$ALTFINS_SKILLS_ROOT/scripts/skills.py" "$@"
  fi
done

echo "Could not locate the altfins-ai-skills repository data. Set ALTFINS_SKILLS_ROOT explicitly if needed." >&2
exit 1
